TARGET = x86_64-pc-windows-gnu
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libkoopman_dmd_r.a
PKG_LIBS = -L$(LIBDIR) -lkoopman_dmd_r -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

# Kept inside the build tree: CRAN packages must not write to the user's home.
CARGOTMP = $(CURDIR)/.cargo
VENDOR_DIR = $(CURDIR)/rust/vendor

all: $(SHLIB) rust_clean

$(SHLIB): $(STATLIB)

$(STATLIB):
	# The vendored tree supplies every dependency; CRAN's machines are offline.
	# The source-replacement config must live in CARGO_HOME rather than beside the
	# manifest, because cargo resolves .cargo/config.toml relative to its working
	# directory (src/), not to --manifest-path.
	mkdir -p $(CARGOTMP)
	export PATH="$(PATH):$(HOME)/.cargo/bin" && \
		export CARGO_HOME=$(CARGOTMP) && \
		if [ -f ./rust/vendor.tar.xz ]; then \
			tar xf ./rust/vendor.tar.xz -C ./rust && \
			printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n[source.vendored-sources]\ndirectory = "$(VENDOR_DIR)"\n' > $(CARGOTMP)/config.toml && \
			cargo build --target=$(TARGET) --lib --release --offline --locked -j 2 \
				--manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR); \
		else \
			cargo build --target=$(TARGET) --lib --release -j 2 \
				--manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR); \
		fi
	if [ "$(NOT_CRAN)" != "true" ]; then \
		rm -Rf $(CARGOTMP) $(VENDOR_DIR) && \
		rm -Rf $(LIBDIR)/build; \
	fi

rust_clean:
	rm -Rf $(CARGOTMP) $(VENDOR_DIR)

C_clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR) $(CARGOTMP) $(VENDOR_DIR)

.PHONY: all rust_clean C_clean clean
